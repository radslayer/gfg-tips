rules_version = '2';

// Three roles, stored in the `roles/{uid}` collection (one doc per user,
// document ID = that user's Firebase Auth UID), each holding
// {role: "admin"}, {role: "manager"}, or {role: "entry"}. The stored
// string stays "admin" for Rod's account (unchanged from the original
// 2-role version, so his already-live roles doc doesn't need editing) --
// the app displays it as "Owner".
//
//   admin   ("Owner" in the app -- Rod) -- everything: the tips form, all
//           payroll requests, the employee roster, and Payroll Report
//           generation.
//   manager ("Manager" -- Mike, Thao) -- can log PTO/purchase/misc/
//           reimbursement requests, can read the employee roster (to pick
//           names from), and can use the tips form as backup for Larry
//           (same submit-lock as entry: once a period is submitted, only
//           an admin can go back and correct it).
//   entry   ("Entry" -- Larry) -- tips form only.
//
// Nobody can read another user's `roles` doc except themselves and admins
// (so nobody can enumerate who has what role).
//
// Every Cloud Function ALSO re-checks role against this same collection
// via the Admin SDK, since an Admin SDK call bypasses these rules
// entirely -- these rules alone would not stop a direct malicious call.
//
// Payroll requests (ptoRequests, employeePurchases, miscAmounts,
// miscReimbursements) are a record that must be kept forever (per Rod,
// 8/31/2026 -- EE withholding problems can surface long after the fact):
// nobody can ever delete one, and once its payrollDate is stamped by a
// Payroll Report run, it can never be edited again by anyone through
// these rules -- a correction is a brand new record, not an edit to an
// old one.

function isSignedIn() {
  return request.auth != null;
}

function myRole() {
  return isSignedIn()
    ? get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role
    : null;
}

function isAdmin() {
  return myRole() == 'admin';
}

function isManager() {
  return myRole() == 'manager';
}

function isEntry() {
  return myRole() == 'entry';
}

function canUseTipsForm() {
  return isAdmin() || isManager() || isEntry();
}

function canLogPayrollRequests() {
  return isAdmin() || isManager();
}

// A request document is only ever create-then-optionally-corrected, never
// truly deleted or altered once payrollDate is stamped. `unrecordedCreate`
// enforces that a brand new record always starts unconsumed; `unrecordedEdit`
// enforces that an edit to an unconsumed record can't sneak a payrollDate/
// recordedAt/recordedBy value in directly (only generate_payroll_report,
// running as Admin SDK and bypassing these rules, is allowed to set those).
function unrecordedCreate() {
  return request.resource.data.payrollDate == null
    && request.resource.data.get('recordedAt', null) == null
    && request.resource.data.get('recordedBy', null) == null;
}

function unrecordedEdit() {
  return resource.data.payrollDate == null
    && request.resource.data.payrollDate == null;
}

service cloud.firestore {
  match /databases/{database}/documents {

    match /roles/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      // Roles are assigned by hand in the Firebase console, not via the app.
      allow write: if false;
    }

    match /tipsPeriods/{periodId} {
      allow read: if isAdmin() || (canUseTipsForm() && resource != null);
      allow create: if canUseTipsForm();
      allow update: if isAdmin()
        || (canUseTipsForm() && resource.data.status == 'open');
      allow delete: if isAdmin();
    }

    match /employees/{employeeId} {
      allow read: if isAdmin() || isManager();
      allow write: if isAdmin();
    }

    // Sister-company (e.g. Easy Entrées) alias map: which alias name a
    // person punches the clock under, and which real employee those hours
    // fold into for wages/OT/tips. Owner-only -- Managers don't need it
    // for anything, and it's config, not a payroll record, so (unlike the
    // four request collections above) it can be edited or removed.
    match /sisterCompanyAliases/{aliasId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /ptoRequests/{id} {
      allow read: if isAdmin() || isManager();
      allow create: if canLogPayrollRequests() && unrecordedCreate();
      allow update: if canLogPayrollRequests() && unrecordedEdit();
      allow delete: if false;
    }

    match /employeePurchases/{id} {
      allow read: if isAdmin() || isManager();
      allow create: if canLogPayrollRequests() && unrecordedCreate();
      allow update: if canLogPayrollRequests() && unrecordedEdit();
      allow delete: if false;
    }

    match /miscAmounts/{id} {
      allow read: if isAdmin() || isManager();
      allow create: if canLogPayrollRequests() && unrecordedCreate();
      allow update: if canLogPayrollRequests() && unrecordedEdit();
      allow delete: if false;
    }

    match /miscReimbursements/{id} {
      allow read: if isAdmin() || isManager();
      allow create: if canLogPayrollRequests() && unrecordedCreate();
      allow update: if canLogPayrollRequests() && unrecordedEdit();
      allow delete: if false;
    }
  }
}
